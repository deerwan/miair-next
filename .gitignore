# Python
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.eggs/
build/
dist/

# 前端
# 注意: 不带尾斜杠, 以便同时忽略 node_modules 软链 (依赖统一放 .workspace/deps)
frontend/node_modules
frontend/dist/
frontend/.vite/
*.local

# 运行数据 (账号 / 密钥 / 配置持久化)
data/
data-airplay2-test/
*.db
secret.key
.mi.token
*.log

# 后端静态目录 (由前端构建产物填充)
backend/app/static/

# fnOS 打包
fnos/*.fpk

# IDE / 系统
.idea/
.vscode/
.DS_Store

# 环境变量 (含密钥, 切勿提交; 保留 .env.example 作为示例)
.env
.env.*
!.env.example
